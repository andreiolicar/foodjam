# Todas as variáveis são opcionais no bootstrap.
TELEGRAM_BOT_TOKEN=
# Opcional: endereço oferecido ao organizador no início (texto livre; ele confirma ou troca).
ENDERECO_PADRAO=
IFOOD_MCP_ENDPOINT=https://consumer-mcp.ifood.com.br/marketplace

# IA: qualquer API compatível com OpenAI (/chat/completions), sem SDK.
# Descubra os ids de modelo com "npm run listar:modelos" e copie o id exato.
# Sem AI_API_KEY, o simulador usa o modelo fake (heurístico, sem rede).
AI_PROVIDER=openai-compat
AI_BASE_URL=
AI_MODEL=
# Opcionais: modelo diferente por nível (fast = coleta e ajuste; capable = proposta).
# AI_MODEL_FAST=
# AI_MODEL_CAPABLE=
# Opcionais: modelo reserva por nível, usado quando o principal responde 429 (cota por
# minuto ou por dia). Use um modelo com cota separada (na Groq, a cota é por modelo).
# AI_MODEL_FAST_FALLBACK=
# AI_MODEL_CAPABLE_FALLBACK=
# Opcionais: reasoning_effort (low, medium, high) para modelos de raciocínio, como
# gpt-oss. Vazio = padrão do provedor. Menos esforço = menos tokens e latência.
# AI_REASONING_EFFORT_FAST=
# AI_REASONING_EFFORT_CAPABLE=
AI_API_KEY=

# Provedor 1 recomendado: Groq (chave em console.groq.com).
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL_CAPABLE=openai/gpt-oss-120b
#
# CASCATA (opcional): provedores reserva, tentados em ordem quando o anterior falha
# (429, 5xx, timeout, rede, chave ou cota). Cada um aceita as mesmas variáveis do
# provedor 1 com o número depois de AI_ (AI_2_MODEL, AI_2_MODEL_FAST, AI_2_API_KEY,
# AI_2_REASONING_EFFORT_FAST...). O que falhou vai para o fim da fila por um tempo
# e volta sozinho. Confirme os ids com "npm run listar:modelos -- 2" e teste cada um
# com "npm run avaliar:coleta -- --provedor 2". Ordem: melhores modelos primeiro.
#
# Provedor 2: Google Gemini (chave em aistudio.google.com). Boa qualidade, cota diária baixa.
# AI_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_2_MODEL_FAST=gemini-2.5-flash-lite
# AI_2_MODEL_CAPABLE=gemini-2.5-flash
# AI_2_API_KEY=
#
# Provedor 3: Mistral (chave em console.mistral.ai, plano gratuito "Experiment").
# AI_3_BASE_URL=https://api.mistral.ai/v1
# AI_3_MODEL_FAST=mistral-small-latest
# AI_3_MODEL_CAPABLE=mistral-medium-latest
# AI_3_API_KEY=
#
# Provedor 4: GitHub Models (token em github.com/settings/tokens com "Models: read").
# A lista de modelos fica em github.com/marketplace/models (o listar:modelos não a lê).
# AI_4_BASE_URL=https://models.github.ai/inference
# AI_4_MODEL_FAST=openai/gpt-4.1-mini
# AI_4_MODEL_CAPABLE=openai/gpt-4.1
# AI_4_API_KEY=
#
# Todos acima têm camada gratuita sem cartão. Cerebras também é compatível, mas pede
# cartão no cadastro: AI_N_BASE_URL=https://api.cerebras.ai/v1, AI_N_MODEL=gpt-oss-120b.
#
# Alternativa: OpenRouter, modelos com sufixo :free (chave em openrouter.ai).
# AI_5_BASE_URL=https://openrouter.ai/api/v1
# AI_5_MODEL=openai/gpt-oss-120b:free
# AI_5_API_KEY=
#
# Tempo máximo de cada provedor antes de passar ao próximo (o último não tem limite
# próprio). Padrão: 10000.
# AI_TIMEOUT_POR_PROVEDOR_MS=10000
#
# Camadas gratuitas limitam requisições por minuto; na avaliação use um intervalo:
#   npm run avaliar:coleta -- --intervalo 4000

# Autenticação do iFood ainda não confirmada.
# Adicionar as variáveis de credenciais somente após confirmar o mecanismo.
# Não presumir token Bearer, API key ou OAuth a partir deste exemplo.
