# Todas as variáveis são opcionais no bootstrap.
TELEGRAM_BOT_TOKEN=
IFOOD_MCP_ENDPOINT=https://consumer-mcp.ifood.com.br/marketplace

# IA: provedor compatível com OpenAI (/chat/completions), sem SDK.
# Exemplo com GLM via OpenCode Zen (endereço da documentação atual do Zen).
# Sem AI_API_KEY, o simulador usa o modelo fake (heurístico, sem rede).
AI_PROVIDER=openai-compat
AI_BASE_URL=https://opencode.ai/inference/openai/v1
AI_MODEL=glm-5.3-flash
# Opcionais: modelo diferente por nível (fast = coleta e ajuste; capable = proposta).
# AI_MODEL_FAST=glm-5.3-flash
# AI_MODEL_CAPABLE=glm-5.3
AI_API_KEY=

# Autenticação do iFood ainda não confirmada.
# Adicionar as variáveis de credenciais somente após confirmar o mecanismo.
# Não presumir token Bearer, API key ou OAuth a partir deste exemplo.
