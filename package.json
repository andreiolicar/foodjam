{
  "name": "foodjam",
  "version": "0.1.0",
  "private": true,
  "description": "Base do foodjam, agente para pedidos coletivos no Telegram com integração MCP do iFood.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "simular": "tsx scripts/simulador.ts",
    "avaliar:coleta": "tsx scripts/avaliar-coleta.ts",
    "listar:modelos": "tsx scripts/listar-modelos.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "18.0.8",
    "grammy": "1.46.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
